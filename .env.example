# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
REFRESH_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database ──────────────────────────────────────────────────────────────────
# Local Compose / CI. On Vercel, Neon injects DATABASE_URL (postgres:// ok — normalized).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flowboard
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/flowboard

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave empty on Vercel to use NullRedis (CRUD demo without Upstash).
REDIS_URL=redis://localhost:6379/0

# ── Celery (Compose worker only — not started on Vercel) ───────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AWS (optional worker tasks) ───────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=flowboard-uploads
SES_FROM_EMAIL=noreply@flowboard.dev

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Extra origins comma-separated; https://*.vercel.app already allowed by regex
CORS_ORIGINS=

# ── Vercel ────────────────────────────────────────────────────────────────────
# RUN_MIGRATIONS_ON_STARTUP=true
# ENVIRONMENT=production

# ── Postgres (docker-compose only) ───────────────────────────────────────────
POSTGRES_DB=flowboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
